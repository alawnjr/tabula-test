# Copy to .env.local and fill in. Without these, the app runs in DEMO_MODE
# (mock fallbacks for upload/extract/Plaid) so the UX is still demoable.

# Set to "false" to require real keys; "true" forces mocks even when keys are set
DEMO_MODE=true

# Anthropic (document extraction)
ANTHROPIC_API_KEY=

# Plaid (sandbox)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=auth,liabilities,assets,transactions
PLAID_COUNTRY_CODES=US
