# Copy to .env.local and fill in. Without these, the app runs in DEMO_MODE
# (mock fallbacks for upload/extract/Teller) so the UX is still demoable.

# Set to "false" to require real keys; "true" forces mocks even when keys are set
DEMO_MODE=true

# Anthropic (document extraction)
ANTHROPIC_API_KEY=

# Teller (https://teller.io/) — Connect runs client-side and returns the
# access_token directly; no client_secret is needed for the JS SDK.
# The applicationId must be NEXT_PUBLIC_* so the browser bundle can read it.
NEXT_PUBLIC_TELLER_APPLICATION_ID=
NEXT_PUBLIC_TELLER_ENVIRONMENT=sandbox

# mTLS client cert + key (PEM file paths). Required for Teller's
# `development` and `production` environments; not needed for `sandbox`.
TELLER_CERT_PATH=
TELLER_KEY_PATH=

# How many months of transaction history to pull per depository account.
# Default 6 (means-test window). Max 12. Note: many banks only return ~90
# days; longer windows may come back partial.
TELLER_TRANSACTION_MONTHS=6
